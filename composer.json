{
    "name": "sekolah-co-id/laboratorium-interaktif",
    "type": "project",
    "description": "Modul Laboratorium Interaktif untuk sekolah.co.id - dibangun di atas platform manajemen sekolah (ujian, buku induk, BK, dsb).",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^2.9|^3.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "tightenco/ziggy": "^2.4",
        "rap2hpoutre/fast-excel": "^5.0",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
